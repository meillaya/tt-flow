{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensixflow.dev/schema/plan.schema.json",
  "title": "TensixFlow Plan",
  "description": "Validation contract for the plan/perf/viz JSON shared by the scheduler, the plan report, and the HTML visualizer. Field names are snake_case to match the project report format. Every perf number is a static projection, never a measured hardware value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graph_id",
    "device",
    "tensors",
    "layout",
    "shard_grid",
    "cb_specs",
    "noc",
    "perf",
    "viz"
  ],
  "properties": {
    "graph_id": {
      "type": "string",
      "description": "Identifier of the fused graph this plan schedules (e.g. \"rmsnorm_matmul\")."
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "description": "Device the plan was scheduled for. Values are copied from spec/devices.json through the generated device table; the name must exist there.",
      "required": [
        "name",
        "arch",
        "grid_x",
        "grid_y",
        "l1_usable_bytes",
        "flops_per_cycle_per_core",
        "dram_bandwidth_bytes_per_second"
      ],
      "properties": {
        "name": { "type": "string", "description": "Device name or alias from spec/devices.json (e.g. \"n150\")." },
        "arch": { "type": "string", "description": "Architecture name (e.g. \"wormhole_b0\" or \"blackhole\")." },
        "grid_x": { "type": "integer", "format": "int64", "description": "Compute grid extent on the X axis, per die." },
        "grid_y": { "type": "integer", "format": "int64", "description": "Compute grid extent on the Y axis, per die." },
        "l1_usable_bytes": { "type": "integer", "format": "int64", "description": "Usable L1 bytes per Tensix core." },
        "flops_per_cycle_per_core": { "type": "integer", "format": "int64", "description": "Matrix unit FLOPs per cycle per core at one fidelity phase." },
        "dram_bandwidth_bytes_per_second": { "type": "integer", "format": "int64", "description": "Published DRAM bandwidth in bytes per second (board aggregate for two-chip products)." }
      }
    },
    "activation_sharding": {
      "type": "string",
      "description": "Optional report field: activation sharding scheme, e.g. \"row-major\". Emitted at the top level by tensixflow-translate; mirrors layout.activation_sharding. Not required so plan::toJson output stays valid."
    },
    "weight_strategy": {
      "type": "string",
      "description": "Optional report field: weight distribution strategy (\"replicate\"/\"shard\"/\"multicast\"). Emitted at the top level by tensixflow-translate; mirrors layout.weight_strategy."
    },
    "intermediate_storage": {
      "type": "string",
      "description": "Optional report field: where the fused intermediate is stored (\"L1\" when fused, else \"DRAM\")."
    },
    "fusion": {
      "type": "string",
      "description": "Optional report field: the fusion decision (\"fused_rmsnorm_matmul\"/\"fused_mlp\"/\"none\")."
    },
    "estimated_dram_reads_saved": {
      "type": "integer",
      "format": "int64",
      "description": "Optional report field: projected DRAM read bytes saved by fusion (the intermediate that no longer round-trips DRAM); 0 when unfused."
    },
    "estimated_intermediate_writes_saved": {
      "type": "integer",
      "format": "int64",
      "description": "Optional report field: projected intermediate DRAM write bytes saved by fusion; 0 when unfused."
    },
    "tensors": {
      "type": "array",
      "description": "Tensors referenced by the plan.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "shape", "dtype", "placement"],
        "properties": {
          "name": { "type": "string", "description": "Logical tensor name." },
          "shape": {
            "type": "array",
            "description": "Static shape (extent of each dimension).",
            "items": { "type": "integer", "format": "int64" }
          },
          "dtype": { "type": "string", "description": "Element dtype, e.g. \"bf16\" or \"fp32\"." },
          "placement": { "type": "string", "enum": ["DRAM", "L1"], "description": "Memory placement." }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation_sharding", "weight_strategy"],
      "properties": {
        "activation_sharding": { "type": "string", "description": "Activation sharding scheme, e.g. \"row-major\"." },
        "weight_strategy": { "type": "string", "enum": ["replicate", "shard", "multicast"], "description": "Weight distribution strategy." }
      }
    },
    "shard_grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grid_y", "grid_x"],
      "properties": {
        "grid_y": { "type": "integer", "format": "int64", "description": "Core-grid height (the device compute grid Y extent)." },
        "grid_x": { "type": "integer", "format": "int64", "description": "Core-grid width (the device compute grid X extent)." }
      }
    },
    "cb_specs": {
      "type": "array",
      "description": "Circular-buffer allocations.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "depth", "tile_bytes"],
        "properties": {
          "index": { "type": "integer", "format": "int64", "description": "CB index (tt::CBIndex, 0..31)." },
          "depth": { "type": "integer", "format": "int64", "description": "Depth in tiles." },
          "tile_bytes": { "type": "integer", "format": "int64", "description": "Bytes per tile (32x32 bf16 = 2048)." }
        }
      }
    },
    "noc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dram_read_bytes", "dram_write_bytes", "l1_bytes", "multicast_bytes"],
      "properties": {
        "dram_read_bytes": { "type": "integer", "format": "int64", "description": "Projected DRAM read traffic (bytes)." },
        "dram_write_bytes": { "type": "integer", "format": "int64", "description": "Projected DRAM write traffic (bytes)." },
        "l1_bytes": { "type": "integer", "format": "int64", "description": "Projected L1 traffic (bytes)." },
        "multicast_bytes": { "type": "integer", "format": "int64", "description": "Projected NoC multicast traffic (bytes)." }
      }
    },
    "perf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["est_cycles", "compute_util", "bottleneck", "suggestions"],
      "properties": {
        "est_cycles": { "type": "integer", "format": "int64", "description": "Projected total cycles from the static roofline model." },
        "compute_util": { "type": "number", "description": "Projected compute utilization fraction (0.0..1.0)." },
        "bottleneck": { "type": "string", "description": "Binding constraint: \"compute\", \"dram\", \"noc\", or \"balanced\"." },
        "suggestions": {
          "type": "array",
          "description": "Suggested optimizations derived from the plan.",
          "items": { "type": "string" }
        }
      }
    },
    "viz": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_grid", "shards", "noc_routes", "cb_usage", "timeline"],
      "properties": {
        "core_grid": { "type": "string", "description": "Visualizer core-grid section placeholder." },
        "shards": { "type": "string", "description": "Visualizer shards section placeholder." },
        "noc_routes": { "type": "string", "description": "Visualizer NoC-routes section placeholder." },
        "cb_usage": { "type": "string", "description": "Visualizer CB-usage section placeholder." },
        "timeline": { "type": "string", "description": "Visualizer timeline section placeholder." }
      }
    }
  }
}
